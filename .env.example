# Copy to .env for local development. In Verdent preview/publish, configure these in My app > Secrets instead.

# Supabase (public project config)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Job data source: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI providers (OpenAI-compatible). Configure at least one.
# Primary
OPENROUTER_API_KEY=
# Optional override, e.g. anthropic/claude-3.5-haiku
OPENROUTER_MODEL=
# Fallback
NVIDIA_API_KEY=
# Optional override, e.g. meta/llama-3.3-70b-instruct
NVIDIA_MODEL=
# Optional: prefer nvidia over openrouter
AI_PROVIDER=
