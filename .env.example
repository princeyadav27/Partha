# Copy to .env for local development. In Verdent preview/publish, configure these in My app > Secrets instead.
#
# SECURITY: every value in this file is read by the Node server only.
# Never prefix any of them with VITE_ — Vite inlines VITE_* values verbatim into
# the public client bundle, which would publish the key to every browser.
# `.env` is gitignored, and `.dockerignore` keeps it out of Docker build layers.

# Supabase (server-side only; never exposed to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Job data source: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI providers (OpenAI-compatible). Configure at least one.
# Primary
OPENROUTER_API_KEY=
# Optional override, e.g. anthropic/claude-3.5-haiku
OPENROUTER_MODEL=
# Fallback
NVIDIA_API_KEY=
# Optional override, e.g. meta/llama-3.3-70b-instruct
NVIDIA_MODEL=
# Optional: prefer nvidia over openrouter
AI_PROVIDER=
